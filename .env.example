# === Telegram (optional — without these, alerts are logged only) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === Kalshi (optional - for authenticated endpoints) ===
KALSHI_API_KEY=
KALSHI_API_SECRET=

# === Bot Settings ===
CHECK_INTERVAL_MINUTES=120
ALERT_THRESHOLD_BPS=15
LANGUAGES=en,he,fr

# === Feature flags ===
ENABLE_MARKET_INTEL=true
ENABLE_PLAYER_INTEL=true

# === Polymarket player watchlist (public proxy wallets, no private keys) ===
# Comma-separated 0x addresses. Optional alias after a colon.
# Example: 0xabc...def:WhaleOne,0x123...789:CopyTarget
POLYMARKET_WATCHLIST=
# Optional JSON file (see watchlist.example.json). Merged with the env list.
WATCHLIST_FILE=
PLAYER_NOTABLE_USD=500
PLAYER_LEADERBOARD_LIMIT=25
PLAYER_LEADERBOARD_PERIOD=DAY
PLAYER_LEADERBOARD_UNUSUAL_USD=25000

# === Paper ledger (simulated fills only — never live) ===
PAPER_MAX_USD=100
PAPER_COPY_RATIO=1.0
# PAPER_LEDGER_FILE=/data/paper_ledger.json
# STATE_FILE=/data/bot_state.json

# === Logging ===
LOG_LEVEL=INFO
